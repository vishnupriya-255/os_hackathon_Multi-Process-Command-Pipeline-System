#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    int fd[2], pid;
    char c1[50], c2[50];

    printf("Enter first command: ");
    scanf(" %49[^\n]", c1);

    printf("Enter second command: ");
    scanf(" %49[^\n]", c2);

    pipe(fd);
    pid = fork();

    if (pid == 0) {
        dup2(fd[1], 1);
        close(fd[0]);
        close(fd[1]);
        execlp("sh", "sh", "-c", c1, NULL);
    }

    pid = fork();

    if (pid == 0) {
        dup2(fd[0], 0);
        close(fd[0]);
        close(fd[1]);
        execlp("sh", "sh", "-c", c2, NULL);
    }

    close(fd[0]);
    close(fd[1]);

    wait(NULL);
    wait(NULL);

    return 0;
}
